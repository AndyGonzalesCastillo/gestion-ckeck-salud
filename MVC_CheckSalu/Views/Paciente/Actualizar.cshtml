@{
    ViewBag.Title = "Actualizar";
}

<h2>Actualizar</h2>
<form id="actualizarForm" method="post" action="@Url.Action("Actualizar")">
    <input type="hidden" name="codAnalisis" value="@Model.codAnalisis" />
    <div class="form-group">
        <label for="descAnalisis">Descripción:</label>
        <input type="text" name="descAnalisis" value="@Model.descAnalisis" class="form-control" required />
    </div>
    <div class="form-group">
        <label for="estAnalisis">Estado:</label>
        <select name="estAnalisis" class="form-control" required>
            <option value="">Selecciona un estado</option>
            <option value="1" @(Model.estAnalisis == 1 ? "selected" : "")>Activo</option>
            <option value="0" @(Model.estAnalisis == 0 ? "selected" : "")>Inactivo</option>
        </select>
    </div>
    <div class="form-group">
        <label for="costo">Costo:</label>
        <input type="text" name="costo" value="@Model.costo" class="form-control" required />
    </div>
    <div class="form-group">
        <label for="Usu_Ult_Mod">Usuario Actualizado Por:</label>
        <input type="text" name="Usu_Ult_Mod" class="form-control" required />
    </div>
    <input type="submit" value="Actualizar" class="btn btn-primary" />
</form>