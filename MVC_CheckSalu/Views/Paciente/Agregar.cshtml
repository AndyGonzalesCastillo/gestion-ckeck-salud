@{
    ViewBag.Title = "Agregar";
}
<h2>Agregar</h2>
<form id="agregarForm" method="post" action="@Url.Action("Agregar")">
    <div class="form-group">
        <label for="Usu_Registro">Registrado por:</label>
        <input type="text" name="Usu_Registro" class="form-control" required />
    </div>
    <div class="form-group">
        <label for="costo">Costo:</label>
        <input type="text" name="costo" class="form-control" required />
    </div>
    <div class="form-group">
        <label for="descAnalisis">Descripción:</label>
        <input type="text" name="descAnalisis" class="form-control" required />
    </div>
    <div class="form-group">
        <label for="estAnalisis">Estado:</label>
        <select name="estAnalisis" class="form-control" required>
            <option value="">Selecciona un estado</option>
            <option value="1">Activo</option>
            <option value="0">Inactivo</option>
        </select>
    </div>
    <input type="submit" value="Enviar" class="btn btn-primary" />
</form>